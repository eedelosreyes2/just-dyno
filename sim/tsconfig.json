{
  // Stricter than the app config: no DOM or React Native globals, so the sim
  // can run unchanged on a server. Check with `npm run typecheck`.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
